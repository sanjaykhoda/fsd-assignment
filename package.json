{
  "name": "quality-inspection-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first quality inspection tracker for shop-floor supervisors",
  "type": "module",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web && npm run build --workspace api",
    "start": "node api/dist/index.js",
    "seed": "npm run seed --workspace api",
    "test": "npm test --workspace api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
