# Copy to .env — every value below has a working default, so .env is optional.
PORT=4000

# SQLite file location (relative paths resolve from the api/ package root)
DB_PATH=data/app.sqlite

# --- Auth (bonus) ---
# Demo credentials. Change these for anything other than a local demo.
AUTH_USERNAME=supervisor
AUTH_PASSWORD=inspect123
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=12h

# --- Mock SAP integration (bonus) ---
# OPTIONAL. Left unset, POST /api/sap-webhook accepts a plain JSON body with no
# authentication, which is the endpoint as specified. Set it to require a
# matching X-SAP-Secret header -- recommended for any real deployment.
# SAP_WEBHOOK_SECRET=sap-dev-secret
